    <title>Stroke Clock</title>
    <style>
        body {
            font-family: "Microsoft JhengHei", Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            padding: 20px;
        }
        
        h1 {
            color: #d32f2f;
        }

        .input-group {
            margin-bottom: 20px;
        }

        label {
            font-size: 20px;
            font-weight: bold;
        }

        input[type="datetime-local"] {
            font-size: 18px;
            padding: 5px;
            margin-left: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            font-size: 20px;
            padding: 10px 30px;
            background-color: #0056b3;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #004494;
        }

        /* 隱藏一開始不需要顯示的區塊 */
        #dtn-container {
            display: none; 
            margin-top: 30px;
        }

        h2 {
            font-size: 24px;
            color: #333;
        }

        /* 電子時鐘的樣式設定 */
        #digital-clock {
            font-size: 72px; /* 72字體大小 */
            font-family: 'Courier New', Courier, monospace; /* 類似電子鐘的等寬字體 */
            background-color: #000; /* 黑色底 */
            color: #00ff00; /* 螢光綠數字 */
            text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00; /* 螢光發光效果 */
            display: inline-block;
            padding: 10px 30px;
            border-radius: 10px;
            border: 3px solid #333;
            letter-spacing: 5px;
        }
    </style>
